{
  "rewrites": [
    { "source": "/", "destination": "/en.html" },
    { "source": "/en", "destination": "/en.html" },
    { "source": "/admin", "destination": "/admin/login.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/login/", "destination": "/admin/login.html" },
    { "source": "/admin/app", "destination": "/admin/app.html" },
    { "source": "/admin/app/", "destination": "/admin/app.html" },
    { "source": "/admin/dashboard", "destination": "/admin/app.html" },
    { "source": "/new/tracking/shipment-details-public", "destination": "/shipment-details-public.html" },
    { "source": "/tracking/shipment-details-public", "destination": "/shipment-details-public.html" },
    { "source": "/shipment-details-public", "destination": "/shipment-details-public.html" },
    { "source": "/api", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api?path=$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/resource/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|webp|png|jpg|jpeg|gif|svg|ico|woff2|woff)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
