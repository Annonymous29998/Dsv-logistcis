# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin portal login (server-only — never expose in frontend)
ADMIN_EMAIL=admin@dsv.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=long-random-secret

# Optional: session lifetime in seconds (default 12h)
ADMIN_SESSION_TTL=43200

# Telegram bot token + chat id are NOT on Vercel.
# Store them as Supabase Edge Function secrets for: chat-telegram-notify
#   supabase secrets set TELEGRAM_BOT_TOKEN=... TELEGRAM_CHAT_ID=...
